# ===== Zoho OAuth (Self Client) =====
# สร้างที่ https://api-console.zoho.com -> Self Client
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ได้จาก: npm run zoho:token -- <grant_code>
ZOHO_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Data center ของ org นี้คือ US (.com) — ถ้าเป็น DC อื่นให้เปลี่ยนทั้งสองค่า
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_CRM_API_VERSION=v7

# ===== App =====
PORT=3000
# URL สาธารณะของเว็บนี้ (ใช้สร้างลิงก์ใน QR) — ไม่ต้องมี / ท้าย
PUBLIC_BASE_URL=https://track.thefirstgoodmangroup.com

# คีย์ลับสำหรับเซ็นลิงก์ลูกค้า (สุ่มยาวๆ: openssl rand -hex 32)
# ถ้าเปลี่ยนค่านี้ ลิงก์/QR เก่าทั้งหมดจะใช้ไม่ได้ทันที
TRACKING_SECRET=change-me-to-a-long-random-string

# คีย์สำหรับ endpoint ภายใน (สร้างลิงก์/QR) — ใช้จากปุ่มใน CRM
ADMIN_API_KEY=change-me-too

# แสดงเฉพาะ Deal ใน Pipeline เหล่านี้ (คั่นด้วย , ว่าง = ทุก pipeline)
ALLOWED_PIPELINES=Tracking
# ซ่อนหน้า tracking เมื่อ Deal อยู่ใน Stage เหล่านี้
HIDDEN_STAGES=ยกเลิก,ไม่ดำเนินการ
# แสดง "เหตุผลที่ล่าช้า" ให้ลูกค้าเห็นหรือไม่
SHOW_DELAY_REASON=true
# แคชข้อมูลจาก CRM (วินาที) ลดจำนวน API call
CACHE_TTL_SECONDS=60

# ===== ข้อมูลติดต่อที่แสดงบนหน้าลูกค้า =====
COMPANY_NAME=The First Good Man Group
CONTACT_PHONE=
CONTACT_LINE_URL=

# ===== ระบบข้อมูลแรงงาน (Foreign Data) — /foreign =====
FOREIGN_ENABLED=true
# คีย์ลับสำหรับ session ผู้ใช้ (สุ่มยาว: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
FOREIGN_SESSION_SECRET=
# อายุการล็อกอิน (นาที)
FOREIGN_SESSION_MINUTES=30
# ซ่อนฟิลด์เพิ่มเติม (API name คั่นด้วย ,) เช่น field20,field18
FOREIGN_HIDDEN_FIELDS=
ZOHO_WORKDRIVE_DOWNLOAD_URL=https://download.zoho.com/v1/workdrive/download
