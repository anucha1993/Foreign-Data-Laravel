APP_NAME="TFG Foreign Data"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===== อีเมล (SMTP ผู้ส่ง) — ใช้ส่งแจ้งเตือน Ticket =====
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_PASSWORD = App Password (ไม่ใช่รหัสปกติ)
# Zoho Mail: MAIL_HOST=smtp.zoho.com, MAIL_PORT=587
# พอร์ต 465 ให้ตั้ง MAIL_SCHEME=smtps / พอร์ต 587 ปล่อย MAIL_SCHEME=null
# กรอกแล้วทดสอบ: php artisan config:clear && php artisan mail:test
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="TFG Foreign Data"

# ผู้รับแจ้งเตือน Ticket (คั่นด้วย , ถ้ามีหลายคน) ว่าง = ส่งถึงบัญชี Admin ทุกคน
TICKET_NOTIFY_EMAILS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===== Zoho OAuth (Self Client) =====
# https://api-console.zoho.com -> Self Client -> Generate Code
# Scope: ZohoCRM.modules.custom.READ,WorkDrive.files.READ
# แล้วรัน: php artisan zoho:token <grant_code>
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Data center ของ org นี้คือ US (.com)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_CRM_API_VERSION=v7
ZOHO_WORKDRIVE_DOWNLOAD_URL=https://www.zohoapis.com/workdrive/api/v1/download
# แคชข้อมูลจาก CRM (วินาที)
CACHE_TTL_SECONDS=60

# ===== ระบบข้อมูลแรงงาน =====
# อายุการล็อกอิน (นาที) นับจากตอนล็อกอิน
FOREIGN_SESSION_MINUTES=30
# ซ่อนฟิลด์เพิ่มเติม (API name คั่นด้วย ,) เช่น field20,field18
FOREIGN_HIDDEN_FIELDS=
# สถานะพนักงานที่ห้ามล็อกอิน (คั่นด้วย ,)
FOREIGN_BLOCKED_STATUSES=ปิดระบบ
# แจ้งเตือนเอกสารใกล้หมดอายุ (วัน)
FOREIGN_EXPIRY_WARNING_DAYS=30
FOREIGN_LOGIN_MAX_PER_IP=10
FOREIGN_LOGIN_MAX_PER_PASSPORT=5

# ===== ข้อมูลบริษัท / ติดต่อ =====
COMPANY_NAME="The First Good Man Group"
CONTACT_PHONE=
CONTACT_LINE_URL=

# ===== แปลภาษา (Google Cloud Translation API) =====
# console.cloud.google.com -> APIs & Services -> เปิด Cloud Translation API -> Credentials -> API key
# ไม่ใส่ = ใช้คำแปลในไฟล์ lang/*.json อย่างเดียว
GOOGLE_TRANSLATE_API_KEY=

# ===== Cloudflare R2 (รูปแนบใน Ticket) =====
# Cloudflare Dashboard -> R2 -> สร้าง bucket (private) -> Manage R2 API Tokens -> Object Read & Write
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ===== Ticket =====
# ส่งอีเมลถึงแรงงานด้วย (true/false) — ปิด = ส่งให้เจ้าหน้าที่อย่างเดียว
TICKET_EMAIL_WORKERS=false
